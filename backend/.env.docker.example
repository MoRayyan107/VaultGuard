# Copy this file to `.env.docker` and fill in your local values.
# These values are used by `backend/docker-compose.yml` and `application.yml`.

# --------------------------------------------------
# KAFKA CONFIGURATION
# --------------------------------------------------

KAFKA_BOOTSTRAP_HOST=kafka
KAFKA_BOOTSTRAP_PORT=9092
KAFKA_GROUP_ID=vaultguard-group
KAFKA_TOPIC=transaction-in

# --------------------------------------------------
# REDIS CONFIGURATION
# --------------------------------------------------

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --------------------------------------------------
# JWT CONFIGURATION
# --------------------------------------------------

JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MILLISECONDS=86400000

# --------------------------------------------------
# DATABASE CONFIGURATION
# --------------------------------------------------

DATASOURCE_HOST=postgres
DATASOURCE_PORT=5432
DATASOURCE_NAME=vaultguard_db
DATASOURCE_USERNAME=vaultguard_user
DATASOURCE_PASSWORD=replace-with-a-strong-password

# --------------------------------------------------
# RATE LIMIT CONFIGURATION (IP BASED AND USERID BASED)
# --------------------------------------------------


IP_RATE_LIMIT_CAPACITY= an integer value
IP_TOKEN_REFILL_RATE= an integer value
IP_REFILL_DURATION_MILLISECONDS= an integer value

USER_RATE_LIMIT_CAPACITY= an integer value
USER_TOKEN_REFILL_RATE= an integer value
USER_REFILL_DURATION_MILLISECONDS= an integer value

# --------------------------------------------------
# COOKIE CONFIGURATION
# --------------------------------------------------

COOKIE_SECURE= nope [true or false]
COOKIE_NAME= u name the cookie [String]
COOKIE_HTTP_ONLY= sure? [true or false]